# Copy to .env and fill in. Never commit .env.

# Only needed if config.yaml sets backend: api. The default backend uses your Claude Code login.
# ANTHROPIC_API_KEY=sk-ant-...

# Sending email (each kid gets her own digest, you get the combined one). For Gmail, create an
# App Password at https://myaccount.google.com/apppasswords and use it as SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=app-password-here
DIGEST_TO=you@gmail.com

# Optional: unattended login for scheduled runs. One pair per student slug, upper-cased.
# The program fills the ClassLink sign-in form with these when no saved session exists.
# CLASSLINK_USER_KID1=student.name
# CLASSLINK_PASS_KID1=...
